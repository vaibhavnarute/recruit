# ==================== ENVIRONMENT VARIABLES TEMPLATE ====================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ==================== Groq API Keys ====================
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Legacy keys (if using different keys for different services)
API_KEY_ANALYSIS=your_groq_api_key_here
API_KEY_QA=your_groq_api_key_here
API_KEY_QUESTIONS=your_groq_api_key_here
API_KEY_IMPROVEMENT=your_groq_api_key_here
API_KEY_IMPROVED_RESUME=your_groq_api_key_here

# ==================== MongoDB Configuration ====================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/
# OR Cloud MongoDB (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Legacy URI name (for compatibility)
MONGO_URI=mongodb://localhost:27017/

# Database name
MONGO_DB_NAME=ai_recruiter

# ==================== Google Meet Bot Credentials ====================
# Create a dedicated Google account for the bot
# IMPORTANT: Disable 2FA or use app-specific password

# Bot Google account email
MEET_BOT_EMAIL=your_bot_email@gmail.com

# Bot Google account password
MEET_BOT_PASSWORD=your_bot_password_here

# ==================== WebSocket Configuration ====================
# WebSocket server settings
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# WebSocket URL for Puppeteer bot to connect
# Use localhost for local development, your server IP/domain for production
WEBSOCKET_URL=ws://localhost:8765

# ==================== FastAPI Configuration ====================
# API server settings
API_HOST=0.0.0.0
API_PORT=8001

# ==================== Google Calendar & Firebase (Optional) ====================
# If you're using interview scheduling features

# Google Calendar API credentials
GOOGLE_CALENDAR_CREDENTIALS_PATH=./google_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./google_token.json

# Firebase configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ==================== Node.js Environment ====================
# Node environment (development or production)
NODE_ENV=development

# ==================== Puppeteer Configuration ====================
# Puppeteer settings
PUPPETEER_HEADLESS=true  # Set to false for debugging
PUPPETEER_EXECUTABLE_PATH=  # Leave empty to use bundled Chromium

# ==================== Logging Configuration ====================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==================== Security (Production Only) ====================
# JWT secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== Optional: Rate Limiting ====================
# API rate limiting
RATE_LIMIT_PER_MINUTE=60

# ==================== Optional: Storage ====================
# File upload directory
UPLOAD_DIR=./uploads

# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE_MB=10

